# ── Copy this to .env and fill in your values ─────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Set this to your ngrok / Railway / Fly.io URL so Twilio/Telnyx can reach you
PUBLIC_URL=https://trudy-unblenched-compressedly.ngrok-free.dev

# ── Telephony ─────────────────────────────────────────────────────────────────
TELEPHONY_PROVIDER=twilio          # twilio | telnyx

# Twilio (prototype — free trial $15 credit)
TWILIO_ACCOUNT_SID=AC2632c0391cf71c40553f61b235b5f171
TWILIO_AUTH_TOKEN=624df556d48592c0737a49ecca1c4967
TWILIO_PHONE_NUMBER=+1 656 255 4379

# Telnyx (production — uncomment when ready)
# TELNYX_API_KEY=KEY0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELNYX_APP_ID=your_telnyx_app_id

# ── Voice Pipeline ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=6a5544abae9ac640f296ab1f5c443ee545b3803a
STT_ENDPOINTING_MS=300
STT_UTTERANCE_END_MS=700
STT_MIN_WORDS=1
TRANSCRIPT_MERGE_HOLD_MS=60
VOICE_MAX_CONTEXT_MESSAGES=6

# TTS: "deepgram" (free, prototype) or "cartesia" (production)
TTS_PROVIDER=deepgram
TTS_VOICE_ID=aura-asteria-en       # Deepgram Aura voice

# Sarvam Bulbul TTS (India-language specialist)
# SARVAM_API_KEY=sk_xxx
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya

# Cartesia (production TTS — uncomment when ready)
# CARTESIA_API_KEY=your_cartesia_api_key
# CARTESIA_VOICE_ID=your_cartesia_voice_id
# TTS_PROVIDER=cartesia

# ── LLM (Google Gemini only) ──────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_key
LLM_MODEL=models/gemini-2.5-flash

# ── Memory ────────────────────────────────────────────────────────────────────
USE_REDIS=false                    # Set true in production / docker-compose
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=7200           # 2 hours

# ── CRM ───────────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
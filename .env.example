# ── Copy this to .env and fill in your values ──────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app

# ── Telephony ────────────────────────────────────────────────────────────────
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── STT ──────────────────────────────────────────────────────────────────────
STT_PROVIDER=sarvam
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── TTS ──────────────────────────────────────────────────────────────────────
TTS_PROVIDER=sarvam
TTS_ALLOW_FALLBACK=false
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=0.92
SARVAM_TTS_LOUDNESS=1.3

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro-preview-06-05

# ── Barge-in behaviour ───────────────────────────────────────────────────────
BARGE_IN_ACK_MODE=sometimes

# ── Google Calendar ───────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# ── Memory ────────────────────────────────────────────────────────────────────
USE_REDIS=false
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=7200

# ── CRM ───────────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# ── Call logs (local QA — one json + .log per call_id when call ends) ─────────
CALL_LOGS_ENABLED=true
CALL_LOGS_DIR=logs/calls
